{
  "manifest_version": 3,
  "name": "ContentLock",
  "version": "1.0.5",
  "description": "ContentLock in-browser filtering: path-level site rules, keyword blocking, and Reddit NSFW filtering.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "reddit.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "storage": {
    "managed_schema": "schema.json"
  }
}
